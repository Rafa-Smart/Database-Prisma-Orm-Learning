// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // ini agar output dari si prisma generate nya ada di folder palina atas
  // di folder.prisma 
  // output   = "../.prisma"
  // .tapi gausah, jadi kita baut default saja, jadi nanti bakal ada di fodler
  // node_module dibawah .bin
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // dari file .env
}

// nah disii adalah tempat kita untuk mmebuat model / tabel

// disini kita buat tabel sample -- setalah baut tabel di terminal

model sample {
  id   String @id
  nama String @db.VarChar(100)
}

// setelah buat model, ketika npx prisma generate untuk membaut clienntnya

// buat model entity customer
model Customer {
  id      String    @id
  nama    String    @db.VarChar(100)
  email   String    @unique @db.VarChar(100)
  phone   String    @unique @db.VarChar(100)
  // disini wallet itu nullale, karea bisa saja customer ini
  // belum memiliki wallet
  wallet  Wallet?
  comment comment[]
  likes   Likes[]

  @@map("customer") // disini kita ubah nama modelnya
}

// lalu silahkan buat tabelnya di database
// setelah itu jangan lupa npx prisma generate

// 3. buat model products
model Product {
  id       Int     @id
  nama     String  @db.VarChar(100)
  price    Int     @db.Int
  stock    Int     @db.Int
  category String  @db.VarChar(100)
  likes    Likes[]

  @@map("products")
}

// membuat one-to-one relation
// membuat tabel wallet
model Wallet {
  id          String    @id @db.VarChar(100)
  balance     Int
  id_customer String?   @db.VarChar(100)
  customer    Customer? @relation(fields: [id_customer], references: [id])
  // di customer ini engga ?
  // karena setiap walet pasti milik satu customer
  // padahal bsia aja jadi coba kita membuatnya nullable

  @@unique([id_customer])
  @@map("wallet")
}

// membuat one-to-many relation
// jadi kita buat tabel comment
model comment {
  id          Int       @id @default(autoincrement()) @db.Int
  title       String    @db.VarChar(100)
  description String?   @db.Text
  id_customer String?
  customer    Customer? @relation(fields: [id_customer], references: [id])
}

// membuat relations many-to-many
// dan membutuhkan tabel penghubug diengahnya
// kita buat tabel penghubung bernama likes
// antara customer dan product

model Likes {
  id_customer String    @db.VarChar(100)
  id_product  Int       @db.Int
  customer    Customer? @relation(fields: [id_customer], references: [id])
  product     Product?  @relation(fields: [id_product], references: [id])

  @@id([id_customer, id_product])
  @@map("likes")
}
